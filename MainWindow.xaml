  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#23344A"/><Setter Property="FontSize" Value="13"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Height" Value="56"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E8EDF3"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F9FE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F2FE"/></Trigger></Style.Triggers></Style>
