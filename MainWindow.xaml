 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DFE7F0" BorderThickness="0,0,0,1">
   <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="46" Height="46" CornerRadius="12" Background="#E7F2FE"><TextBlock Text="⚖" FontSize="23" Foreground="#2875D1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="FFB0 BODY SCALE" FontSize="14" FontWeight="Bold" Foreground="#132238"/><TextBlock Text="FFB0 protocol · Bluetooth LE" FontSize="10" Foreground="#68788D" Margin="0,3,0,0"/></StackPanel><Border Width="1" Height="38" Background="#DFE7F0" Margin="15,0"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Patient archive" Foreground="{StaticResource Ink}" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Measurements organized by patient and date" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ArchiveNavButton" Content="Patient archive" Style="{StaticResource Outline}" Width="145" Margin="0,0,9,0"/><Button x:Name="NewNavButton" Content="+  New measurement" Style="{StaticResource Primary}" Width="166"/>
     <Border x:Name="ConnectionPill" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#DDE6EF" BorderThickness="1" CornerRadius="18" Padding="13,8" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#9AA6B3" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="Disconnected" Foreground="#566476" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
    </StackPanel>
   </Grid>
  </Border>

  <Grid x:Name="ArchivePanel" Grid.Row="1" Margin="30,24,30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Width="420" HorizontalAlignment="Left"><TextBox x:Name="SearchBox" ToolTip="Search by patient name or date" Padding="37,7,12,7"/><TextBlock Text="⌕" FontSize="21" Foreground="#7890A8" Margin="12,-2,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="Search by patient name or date…" Foreground="#8996A7" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <TextBlock Grid.Column="1" Text="Double-click a record to view its details" Foreground="#8290A2" FontSize="11" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Row="1" Background="White" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="14" Padding="1"><Grid>
    <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeaderWidth="0" Background="White" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="PATIENT" Binding="{Binding patient_name}" Width="2.2*"/><DataGridTextColumn Header="DATE AND TIME" Binding="{Binding DateDisplay}" Width="1.55*"/><DataGridTextColumn Header="WEIGHT" Binding="{Binding WeightDisplay}" Width="*"/><DataGridTextColumn Header="BMI" Binding="{Binding BmiDisplay}" Width=".8*"/><DataGridTextColumn Header="BODY FAT" Binding="{Binding FatDisplay}" Width="1.25*"/><DataGridTextColumn Header="HEART RATE" Binding="{Binding PulseDisplay}" Width="*"/></DataGrid.Columns></DataGrid>
    <StackPanel x:Name="ArchiveEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="54" Height="54" Background="#EAF3FE" CornerRadius="16"><TextBlock Text="☷" Foreground="#2C77D2" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="The archive is empty" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/><TextBlock Text="Create the first measurement to get started." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Row="2" Margin="0,13,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="RecordCountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock Text="•" Foreground="#B4BFCA" Margin="12,0" VerticalAlignment="Center"/><TextBlock Text="Data stays on this PC" Foreground="#8290A2" FontSize="11" VerticalAlignment="Center"/><Button x:Name="OpenLogsButton" Content="Technical logs" Style="{StaticResource Quiet}" Height="34" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExportButton" Content="Export CSV" Style="{StaticResource Outline}" Width="125" Margin="0,0,9,0"/><Button x:Name="OpenRecordButton" Content="Open record" Style="{StaticResource Primary}" Width="135" IsEnabled="False"/></StackPanel></Grid>
  </Grid>

  <ScrollViewer x:Name="MeasurementScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="30,22,30,28"><StackPanel>
   <Border x:Name="DetailHeader" Visibility="Collapsed" Background="#EAF3FE" BorderBrush="#CFE1F5" BorderThickness="1" CornerRadius="14" Padding="19" Margin="0,0,0,14"><Grid><StackPanel><TextBlock x:Name="DetailPatientText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="DetailMetaText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PrintButton" Content="Print" Style="{StaticResource Primary}" Width="120" Margin="0,0,9,0"/><Button x:Name="BackButton" Content="←  Back to archive" Style="{StaticResource Outline}" Width="155"/></StackPanel></Grid></Border>
   <Border x:Name="PatientFormCard" Background="White" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,14"><StackPanel><Grid Margin="0,0,0,17"><StackPanel><TextBlock Text="Patient details" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="All marked fields are required for BIA estimates." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Border HorizontalAlignment="Right" Background="#F0F5FA" CornerRadius="12" Padding="10,5"><TextBlock Text="STEP 1 OF 2" Foreground="#58708A" FontSize="10" FontWeight="Bold"/></Border></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Full name *" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/><Grid><TextBox x:Name="PatientNameBox"/><Popup x:Name="PatientSuggestionsPopup" PlacementTarget="{Binding ElementName=PatientNameBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#C8D7E7" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,4,0,0"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16"/></Border.Effect><ListBox x:Name="PatientSuggestionsList" Background="Transparent" BorderThickness="0" MaxHeight="260" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="11,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SuggestionRow" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SuggestionRow" Property="Background" Value="#F0F6FD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="SuggestionRow" Property="Background" Value="#E4F0FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" Foreground="#1D3148" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#75869A" FontSize="10" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Popup></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Height (cm) *" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/><TextBox x:Name="HeightBox"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Age *" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/><TextBox x:Name="AgeBox"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="Sex *" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/><ComboBox x:Name="SexBox"><ComboBoxItem Content="Male"/><ComboBoxItem Content="Female"/></ComboBox></StackPanel></Grid>
    <Grid Margin="0,18,0,0"><CheckBox x:Name="AthleteBox" Content="Athlete mode" VerticalAlignment="Center" Foreground="#34475D"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource Outline}" Width="125" IsEnabled="False" Margin="0,0,9,0"/><Button x:Name="ConnectButton" Content="Connect to scale" Style="{StaticResource Primary}" Width="176" IsEnabled="False"/></StackPanel></Grid>
   </StackPanel></Border>
   <Border x:Name="EmptyPanel" Background="#F9FBFE" BorderBrush="#DCE6F1" BorderThickness="1" CornerRadius="14" Padding="26" MinHeight="205"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="58" Height="58" Background="#E5F0FD" CornerRadius="17" VerticalAlignment="Center"><TextBlock Text="⚖" Foreground="#2875D1" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ActivityTitle" Text="Ready to measure" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="StatusText" Text="Complete the patient details to enable connection." Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="LiveWeightText" Text="" Foreground="#2875D1" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" Visibility="Collapsed"/><ProgressBar x:Name="ActivityProgress" IsIndeterminate="True" Height="5" Width="420" HorizontalAlignment="Left" Margin="0,13,0,0" Visibility="Collapsed"/><TextBlock Text="Wake the scale and keep one foot on it while Bluetooth connects." Foreground="#7C8DA0" FontSize="11" Margin="0,9,0,0"/></StackPanel><Border Grid.Column="2" Background="White" BorderBrush="#DFE7F0" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center"><StackPanel><TextBlock Text="STEP 2 OF 2" Foreground="#5B7086" FontSize="10" FontWeight="Bold"/><TextBlock Text="Connect and measure" Foreground="#263B52" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border></Grid></Border>
   <StackPanel x:Name="Dashboard" Visibility="Collapsed"><Border Background="White" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WEIGHT" Foreground="#7B899B" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="WeightText" Text="— kg" FontSize="42" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="WeightAssessment" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="WeightReference" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="ResultStatusText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel><Grid x:Name="WeightBarHost" Grid.Column="1" Margin="24,20,0,0"/></Grid></Border><UniformGrid x:Name="CardsPanel" Columns="3"/></StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
